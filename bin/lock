#!/usr/bin/env bash
# Blurred gruvbox lock screen (swaylock-effects)
pgrep -x swaylock >/dev/null && exit 0
exec swaylock -f --screenshots --clock --indicator --indicator-radius 110 --indicator-thickness 8 \
  --effect-blur 8x5 --effect-vignette 0.4:0.6 --fade-in 0.2 --grace 2 \
  --font "Monaspace Neon" --timestr "%H:%M" --datestr "%a, %d %b" \
  --ring-color 009F9F --key-hl-color fabd2f --bs-hl-color fb4934 \
  --ring-ver-color 83a598 --ring-wrong-color fb4934 --ring-clear-color 8ec07c \
  --inside-color 282828cc --inside-ver-color 282828cc --inside-wrong-color 282828cc --inside-clear-color 282828cc \
  --text-color ebdbb2 --text-ver-color ebdbb2 --text-wrong-color fb4934 --text-clear-color ebdbb2 \
  --line-color 00000000 --line-ver-color 00000000 --line-wrong-color 00000000 --line-clear-color 00000000 \
  --separator-color 00000000
