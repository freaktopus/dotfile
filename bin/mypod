#!/usr/bin/env bash
# mypod        connect the AirPods
# mypod off    disconnect
# (Only connects. Pair them once first: right-click the Bluetooth icon in waybar -> Blueman.)
NAME="freakpod"                     # Bluetooth name of the AirPods

say() { echo "$1"; notify-send -a Bluetooth -t 2500 "AirPods" "${1#* }" 2>/dev/null || true; }

# Bluetooth on
rfkill unblock bluetooth 2>/dev/null
bluetoothctl show | grep -q "Powered: yes" || { bluetoothctl power on >/dev/null; sleep 1; }

mac=$(bluetoothctl devices Paired | grep -iF "$NAME" | awk '{print $2; exit}')
[[ -z $mac ]] && { say "❌ $NAME is not paired with this laptop. Pair it once in Blueman."; exit 1; }

if [[ ${1:-} == off ]]; then
  bluetoothctl disconnect "$mac" >/dev/null && say "🔌 Disconnected $NAME"
  exit
fi

if bluetoothctl info "$mac" | grep -q "Connected: yes"; then
  say "✅ $NAME already connected"; exit 0
fi

echo "🎧 Connecting to $NAME ($mac)..."
for attempt in 1 2 3; do                  # AirPods sometimes refuse the first try
  if timeout 15 bluetoothctl connect "$mac" >/dev/null 2>&1; then
    say "✅ Connected to $NAME"; exit 0
  fi
  sleep 2
done
say "❌ Couldn't connect to $NAME. Open the case or put them in your ears, then run mypod again."
exit 1
